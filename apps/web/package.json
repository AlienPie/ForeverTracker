    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
