FOREVERDB_API_KEY=
CONTENT_MODE=mirror
DATA_DIR=./data-local
# Hover tooltips for item/quest links: none (default, no third-party requests), wowhead or foreverdb.
# Enabling one makes visitors' browsers contact that provider (see README).
TOOLTIP_PROVIDER=none
# generate with: openssl rand -base64 32
SESSION_SECRET=
OWNER_PASSWORD=
OWNER_BATTLETAG=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REDIRECT_URI=
# adapter-node request body limit; must be >= the ingest handler's 8 MB cap
BODY_SIZE_LIMIT=8M
# Only behind a reverse proxy (see README "Plain HTTP and reverse proxies").
# PROTOCOL_HEADER defaults to x-forwarded-proto; HOST_HEADER=x-forwarded-host if the proxy rewrites Host.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
